  // crumpled dummy can twitch one limb above the rest band indefinitely
  // (probe-stage5 2026-10-28: parts oscillating at ~0.4-0.8 speed); after
  // 30 game-seconds of flight with everything below 1.0 speed, judge anyway
  // so a turn can never hang forever.
  var stalled=flySteps>1800&&restState.maxBodySpeed<1.0;
  if(!restState.allRest&&!stalled)return;
  flySteps=0;
  var alive=breakables.filter(function(b){return b.plugin.material==='pumpkin';}).length;
  if(alive===0){gameState.phase='won';gameState.stars=calcStars();}
  else if(gameState.dummiesLeft>0){removeCurrentDummy();spawnFreshDummy();gameState.phase='ready';}
  else{gameState.phase='lost';}
