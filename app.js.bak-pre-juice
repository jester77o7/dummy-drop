var LEVEL_BUILDERS={1:buildLevel1,2:buildLevel2,3:buildLevel3};
function buildTower(level){
  tower=[];towerPumpkins=[];towerPumpkin=null;
  (LEVEL_BUILDERS[level]||buildLevel1)();
  M.Composite.add(world,tower);
  for(var i=0;i<towerPumpkins.length;i++)M.Composite.add(world,towerPumpkins[i]);
  // Pre-settle (F2 fix, self critique #1, 2026-10-28 23:5x CT): a tall stack
  // sags ~1-1.5 px per contact layer in the solver during its first ~2 s
  // (L3's cap sank 10.26 px over 7 layers, then froze solid). Run 150 fixed
  // steps (2.5 s of game time) NOW, before the start snapshot, so the level
  // is presented already settled and towerStart measures the standing tower
  // the player actually sees. This hides nothing: a genuinely unstable
  // structure still collapses or keeps drifting after the pre-settle, and
  // the 30 s stability test still catches that. Settle speeds are ~0.1-0.5,
  // far under every damage threshold (glass 2.5), and no pumpkin has a heavy
  // body resting on it in any layout, so no damage or crush can trigger.
  for(var ps=0;ps<150;ps++)M.Engine.update(engine,1000/60);
  towerStart=tower.map(function(b){return {x:b.position.x,y:b.position.y,angle:b.angle};});
}
buildTower(1);

var pendingRemoval=[];
function damageBody(b,amount){
  if(!b.plugin||!b.plugin.material||b.plugin.dead)return;
  b.plugin.health-=amount;
  if(b.plugin.health<=0 && pendingRemoval.indexOf(b)<0)pendingRemoval.push(b);
}
function relSpeed(a,b){return Math.hypot(a.velocity.x-b.velocity.x,a.velocity.y-b.velocity.y);}
M.Events.on(engine,'collisionStart',function(ev){
  for(var i=0;i<ev.pairs.length;i++){
    var p=ev.pairs[i];
    var rs=relSpeed(p.bodyA,p.bodyB);
    var sides=[[p.bodyA],[p.bodyB]];
    for(var s=0;s<2;s++){
      var b=sides[s][0];
      if(b.plugin&&b.plugin.material){
        var th=MATERIALS[b.plugin.material].threshold;
        if(rs>th)damageBody(b,rs);
      }
    }
  }
});
M.Events.on(engine,'collisionActive',function(ev){
  // Crush: a heavy body (mass >= 2) resting on top of a pumpkin for ~30 steps
  // (~0.5 s at 60 steps/s) squashes it, even at near-zero impact speed.
  for(var i=0;i<ev.pairs.length;i++){
    var p=ev.pairs[i];
    var pk=null,other=null;
    if(p.bodyA.plugin&&p.bodyA.plugin.material==='pumpkin'){pk=p.bodyA;other=p.bodyB;}
    else if(p.bodyB.plugin&&p.bodyB.plugin.material==='pumpkin'){pk=p.bodyB;other=p.bodyA;}
    if(!pk||pk.plugin.dead||other.isStatic)continue;
    if(other.position.y<pk.position.y-10 && other.mass>=2){
      pk.plugin.crush++;
      if(pk.plugin.crush>=30)damageBody(pk,pk.plugin.health+1);
    }
  }
});
var gameState={level:1,dummiesLeft:5,launchesUsed:0,phase:'ready',stars:0};
function updateHUD(){
  var el=document.getElementById('hud-info');
  // Shortened (Stage 7, H2 fix): the long Stage 5 line clipped on the right
  // in every screenshot (critique #3). "Dummies: N" wording is kept verbatim
  // (test-stage5 reads it); block/pumpkin counts move to short forms.
  if(el)el.textContent='Level '+gameState.level+' | Dummies: '+gameState.dummiesLeft+' | Score '+scoreState.score+' | Blk '+scoreState.blocksBroken+' | Pkn '+scoreState.pumpkinsSquashed+' | '+gameState.phase;
  if(typeof syncLevelButtons==='function')syncLevelButtons();
  updateOverlay();
}
function updateOverlay(){
  var ov=document.getElementById('overlay');if(!ov)return;
  var title=document.getElementById('overlay-title'),txt=document.getElementById('overlay-text'),nx=document.getElementById('btn-next');
  if(gameState.phase==='won'){ov.style.display='block';title.textContent='Level cleared!';txt.textContent='Stars: '+gameState.stars+' of 3 | Score '+scoreState.score;nx.style.display='inline-block';}
  else if(gameState.phase==='lost'){ov.style.display='block';title.textContent='Out of dummies';txt.textContent='Pumpkins left: '+breakables.filter(function(b){return b.plugin.material==='pumpkin';}).length+' | Score '+scoreState.score;nx.style.display='none';}
  else{ov.style.display='none';}
}
M.Events.on(engine,'afterUpdate',function(){
  if(!pendingRemoval.length)return;
  var list=pendingRemoval;pendingRemoval=[];
  for(var i=0;i<list.length;i++){
    var b=list[i];b.plugin.dead=true;
    if(b.plugin.material==='pumpkin'){scoreState.pumpkinsSquashed++;scoreState.score+=100;}
    else{scoreState.blocksBroken++;scoreState.score+=10;}
    M.Composite.remove(world,b);
    var ix=breakables.indexOf(b);if(ix>=0)breakables.splice(ix,1);
  }
  updateHUD();
});

// --- Ragdoll factory ---
// Scale 0.25 EXACT (Alexander decision 13, fixed 2026-10-28 22:45 CT: "Make him
// 1/4 of the size he is currently" = 0.25 of the ORIGINAL scale-1 sizes; the
// interim 0.75 build was wrong and is superseded). Every part size, offset,
// chamfer and joint anchor below is the scale-1 official size (research notes
// section 1) multiplied by 0.25; density stays 0.001 so each part's mass scales
// with its area (total ~0.86 vs ~13.8 at scale 1). Total height ~52 px
// (head top -20 to feet +31.75, relative to chest centre).
function createDummy(x,y){
  var group=M.Body.nextGroup(true); // ONE shared negative group: parts never collide with each other
  function part(name,w,h,ox,oy,chamfer){
    return M.Bodies.rectangle(x+ox,y+oy,w,h,{
      density:0.001,friction:0.5,frictionAir:0.01,restitution:0,
      collisionFilter:{group:group},label:'dummy',
      chamfer:{radius:chamfer},plugin:{part:name,w:w,h:h}
    });
  }
  var head=part('head',8.5,10,0,-15,3.5);
  var chest=part('chest',13.75,20,0,0,5);
  var uArmL=part('upperArmL',5,10,-9.75,-3.75,2);
  var lArmL=part('lowerArmL',5,15,-9.75,6.25,2);
  var uArmR=part('upperArmR',5,10,9.75,-3.75,2);
  var lArmR=part('lowerArmR',5,15,9.75,6.25,2);
  var uLegL=part('upperLegL',5,10,-5,14.25,2);
  var lLegL=part('lowerLegL',5,15,-5,24.25,2);
  var uLegR=part('upperLegR',5,10,5,14.25,2);
  var lLegR=part('lowerLegR',5,15,5,24.25,2);
  var parts=[head,chest,uArmL,lArmL,uArmR,lArmR,uLegL,lLegL,uLegR,lLegR];
  function joint(a,pa,b,pb,stiff){
    return M.Constraint.create({bodyA:a,pointA:pa,bodyB:b,pointB:pb,stiffness:stiff,damping:0});
  }
  // Dual-anchor joint: two constraints offset sideways by `off` px. A single point
  // joint lets a part rotate freely around the pivot (the head toppled at hang and
  // limbs windmilled multiple full turns in the first test, probe-stage2 2026-10-28);
  // the second anchor resists rotation while staying floppy. Stiffness raised from
  // the research 0.6 to 0.9 per the research note itself: "If the dummy stretches
  // apart during the slingshot pull, raise joint stiffness before anything else."
  function dual(a,pa,b,pb,stiff,off){
    return [
      joint(a,{x:pa.x-off,y:pa.y},b,{x:pb.x-off,y:pb.y},stiff),
      joint(a,{x:pa.x+off,y:pa.y},b,{x:pb.x+off,y:pb.y},stiff)
    ];
  }
  var joints=[];
  // Joint anchors = the proven 0.75-build anchors divided by 3 (= 0.25 of the
  // original geometry), dual offsets likewise (6->2, 5->1.67).
  joints=joints.concat(dual(head,{x:0,y:5},chest,{x:0,y:-9.67},0.9,2));
  joints=joints.concat(dual(chest,{x:-6.67,y:-6.33},uArmL,{x:0,y:-4.67},0.9,1.67));
  joints=joints.concat(dual(chest,{x:6.67,y:-6.33},uArmR,{x:0,y:-4.67},0.9,1.67));
  joints=joints.concat(dual(uArmL,{x:0,y:4.67},lArmL,{x:0,y:-7},0.9,1.67));
  joints=joints.concat(dual(uArmR,{x:0,y:4.67},lArmR,{x:0,y:-7},0.9,1.67));
  joints=joints.concat(dual(chest,{x:-5,y:9.67},uLegL,{x:0,y:-4.67},0.9,1.67));
  joints=joints.concat(dual(chest,{x:5,y:9.67},uLegR,{x:0,y:-4.67},0.9,1.67));
  joints=joints.concat(dual(uLegL,{x:0,y:4.67},lLegL,{x:0,y:-7},0.9,1.67));
  joints=joints.concat(dual(uLegR,{x:0,y:4.67},lLegR,{x:0,y:-7},0.9,1.67));
  joints.push(joint(lLegL,{x:0,y:0},lLegR,{x:0,y:0},0.01));
  // Rest distances between joint anchors at spawn (rotation 0, so position+offset).
  var rest=joints.map(function(c){
    var ax=c.bodyA.position.x+c.pointA.x, ay=c.bodyA.position.y+c.pointA.y;
    var bx=c.bodyB.position.x+c.pointB.x, by=c.bodyB.position.y+c.pointB.y;
    return Math.hypot(bx-ax,by-ay);
  });
  var comp=M.Composite.create({label:'dummy'});
  M.Composite.add(comp,parts);
  M.Composite.add(comp,joints);
  return {composite:comp,parts:parts,chest:chest,joints:joints,rest:rest,byName:{
    head:head,chest:chest,uArmL:uArmL,lArmL:lArmL,uArmR:uArmR,lArmR:lArmR,
    uLegL:uLegL,lLegL:lLegL,uLegR:uLegR,lLegR:lLegR}};
}
var dummy=createDummy(ANCHOR.x,ANCHOR.y);
M.Composite.add(world,dummy.composite);
var chest=dummy.chest;
// Elastic stiffness tuned up from the official 0.05: the ragdoll's total mass is
// ~13.8 vs the official rock's ~5, and at 0.05 it could not reach the tower
// (probe/test 2026-10-28: best chest landing x=803, tower base x=980). Research
// notes flag exactly this tuning.
var elastic=M.Constraint.create({pointA:{x:ANCHOR.x,y:ANCHOR.y},bodyB:chest,pointB:{x:0,y:0},stiffness:0.12,damping:0});
M.Composite.add(world,elastic);

var dragging=false,firing=false,launched=false;
function clampToAnchor(p){
  var dx=p.x-ANCHOR.x,dy=p.y-ANCHOR.y;var d=Math.hypot(dx,dy);
  if(d>MAX_DRAG){dx=dx/d*MAX_DRAG;dy=dy/d*MAX_DRAG;}
  return {x:ANCHOR.x+dx,y:ANCHOR.y+dy};
}
function moveDummyTo(newChest){
  var dx=newChest.x-chest.position.x, dy=newChest.y-chest.position.y;
  for(var i=0;i<dummy.parts.length;i++){
    var b=dummy.parts[i];
    M.Body.setPosition(b,{x:b.position.x+dx,y:b.position.y+dy});
    M.Body.setVelocity(b,{x:0,y:0});
    M.Body.setAngularVelocity(b,0);
  }
}
function setDummyStatic(v){
  for(var i=0;i<dummy.parts.length;i++){M.Body.setStatic(dummy.parts[i],v);if(!v)M.Sleeping.set(dummy.parts[i],false);}
}
var canvas=document.getElementById('game');
var ctx=canvas.getContext('2d');
function toGame(e){var r=canvas.getBoundingClientRect();return {x:(e.clientX-r.left)*(W/r.width),y:(e.clientY-r.top)*(H/r.height)};}
canvas.addEventListener('mousedown',function(e){
  var p=toGame(e);
  if(!launched && Math.hypot(p.x-chest.position.x,p.y-chest.position.y)<70){dragging=true;setDummyStatic(true);}
});
window.addEventListener('mousemove',function(e){
  if(!dragging)return;moveDummyTo(clampToAnchor(toGame(e)));
});
window.addEventListener('mouseup',function(){
  if(!dragging)return;dragging=false;setDummyStatic(false);firing=true;restState.restSteps=0;restState.allRest=false;
});
M.Events.on(engine,'afterUpdate',function(){
  if(firing && elastic.bodyB){
    var d=Math.hypot(chest.position.x-ANCHOR.x,chest.position.y-ANCHOR.y);
    if(d<20){elastic.bodyB=null;firing=false;launched=true;gameState.launchesUsed++;gameState.dummiesLeft=Math.max(0,5-gameState.launchesUsed);gameState.phase='flying';restState.restSteps=0;restState.allRest=false;flySteps=0;updateHUD();}
  }
});

function botLaunch(dragX,dragY){
  if(launched||gameState.phase==='won'||gameState.phase==='lost')return false;
  setDummyStatic(true);
  moveDummyTo(clampToAnchor({x:dragX,y:dragY}));
  setDummyStatic(false);firing=true;
  // Rest-state reset on every launch (fix 2026-10-28 22:5x CT, Stage 4
  // re-verification): the tiny 0.25 dummy sits perfectly still at the anchor,
  // so allRest was already true from pre-launch stillness and a rest check
  // could judge the flight before it began. Rest must be re-earned in flight.
  restState.restSteps=0;restState.allRest=false;
  return true;
}
function jointStretch(){
  // Matter MUTATES constraint pointA/pointB in place: it rotates them with the
  // body each solve, so a live point is already the world-frame offset from the
  // body centre. World anchor = position + point, NO extra rotation. (Verified
  // 2026-10-28 with probe-joint.js: rotating again double-counts and invents
  // ~100 px of phantom stretch; the direct sum gives distances at rest.)
  var max=0,worst=-1;
  for(var i=0;i<dummy.joints.length;i++){
    var c=dummy.joints[i];
    var ax=c.bodyA.position.x+c.pointA.x, ay=c.bodyA.position.y+c.pointA.y;
    var bx=c.bodyB.position.x+c.pointB.x, by=c.bodyB.position.y+c.pointB.y;
    var d=Math.hypot(bx-ax,by-ay);
    var stretch=Math.abs(d-dummy.rest[i]);
    if(stretch>max){max=stretch;worst=i;}
  }
  return {maxStretchPx:max,worstJoint:worst};
}
function bodyHealth(id){
  var all=M.Composite.allBodies(world);
  for(var i=0;i<all.length;i++){if(all[i].id===id)return {exists:true,health:all[i].plugin?all[i].plugin.health:null,material:all[i].plugin?all[i].plugin.material:null};}
  return {exists:false,health:null,material:null};
}
function spawnBlockAt(mat,x,y,w,h){var b=makeBlock(x,y,w,h,mat);M.Composite.add(world,b);return b.id;}
function spawnPumpkinAt(x,y){var b=makePumpkin(x,y);M.Composite.add(world,b);return b.id;}
function testImpact(material,speed){
  // Scripted impact: target and a heavy ball spawn together in mid-air and fall
  // together, so their relative speed at contact is the ball's set speed.
  var target=(material==='pumpkin')?makePumpkin(800,300):makeBlock(800,300,44,44,material);
  M.Composite.add(world,target);
  var ball=M.Bodies.circle(745,300,16,{density:0.005,friction:0.1,restitution:0,label:'testball'});
  M.Composite.add(world,ball);
  M.Body.setVelocity(ball,{x:speed,y:0});
  return {targetId:target.id,ballId:ball.id};
}
// --- Stage 4 PHYSICS HARDENING instrumentation (Muse hand-coded) ---
// Step timing: measured around every fixed Engine.update in the frame loop.
// Rest detection (quality bar: "Rest before judgment"): allRest is true only
// after EVERY non-static body stays below 0.15 speed AND 0.15 angular speed,
// or asleep, for a full second (60 consecutive steps).
var stepStats={steps:0,totalMs:0,maxMs:0,lastMs:0};
