// Dummy Drop - Stage 2 RAGDOLL (hand-coded by Muse, foreman)
// Matter.js fixed timestep, custom canvas drawing (not Matter Render).
// Ragdoll per research notes section 1: official part sizes, joint stiffness 0.6,
// legs link 0.01, ONE shared negative collision group per dummy.
(function(){
'use strict';
window.__errors=[];
window.addEventListener('error',function(e){window.__errors.push(String(e.message||e.error||'unknown'));});

var M=Matter;
var W=1280,H=720,GROUND_Y=680;
var ANCHOR={x:180,y:540};
var MAX_DRAG=140;

var engine=M.Engine.create({enableSleeping:true,positionIterations:6,velocityIterations:4,constraintIterations:2});
// F2 note (self critique #1): iterations 10/6 were TRIED on 2026-10-28
// 23:40 CT and REVERTED the same night: they cut stack sag (L3 cap settle
// 10.26 -> 7.23 px) but the stiffer solver broke the collapse/crush gameplay
// the levels were tuned under (test-stage6 fell to 11/13: L1 and L2 became
// unbeatable in 5 dummies). Sag is fixed by build-time pre-settling in
// buildTower instead, which changes no in-play physics.
engine.gravity.y=1;
var world=engine.world;

var ground=M.Bodies.rectangle(W/2,GROUND_Y+20,W+200,40,{isStatic:true,friction:1,frictionStatic:10,restitution:0,label:'ground'});
var wallL=M.Bodies.rectangle(-20,H/2,40,H*2,{isStatic:true,label:'wall'});
var wallR=M.Bodies.rectangle(W+20,H/2,40,H*2,{isStatic:true,label:'wall'});
var ceil=M.Bodies.rectangle(W/2,-40,W+200,40,{isStatic:true,label:'wall'});
M.Composite.add(world,[ground,wallL,wallR,ceil]);

// --- Materials and breakage (Stage 3, Muse hand-sets the rules) ---
// Numbers from the physics research notes section 3: damage = relative speed at
// collisionStart once it passes the material threshold; health pools glass 3,
// wood 10, stone 40, pumpkin 4. Cracked look at half health (drawing only).
var MATERIALS={
  glass:{density:0.0008,threshold:2.5,health:3,color:'#bfe6ef'},
  wood:{density:0.001,threshold:4,health:10,color:'#9a6a35'},
  stone:{density:0.002,threshold:9,health:40,color:'#7d7d7d'},
  pumpkin:{density:0.0008,threshold:4,health:4,color:'#e07b1f'}
};
var scoreState={score:0,blocksBroken:0,pumpkinsSquashed:0};
var breakables=[];
function regBreakable(b){breakables.push(b);return b;}
function makeBlock(x,y,w,h,mat){
  var m=MATERIALS[mat];
  return regBreakable(M.Bodies.rectangle(x,y,w,h,{density:m.density,friction:0.8,frictionStatic:1.5,restitution:0,label:'block',plugin:{material:mat,health:m.health,maxHealth:m.health,w:w,h:h,crush:0}}));
}
function makePumpkin(x,y){
  // Plain whole pumpkin, stem on top when drawn, NO face (Alexander's locked rule).
  return regBreakable(M.Bodies.circle(x,y,24,{density:MATERIALS.pumpkin.density,friction:0.6,frictionStatic:1,restitution:0,label:'pumpkin',plugin:{material:'pumpkin',health:MATERIALS.pumpkin.health,maxHealth:MATERIALS.pumpkin.health,radius:24,crush:0}}));
}
var tower=[];var towerPumpkin=null;var towerPumpkins=[];var towerStart=[];
var baseY=GROUND_Y;
// --- Stage 6 STRUCTURE BUILDER (Muse hand-coded) ---
// Helpers place blocks by their BOTTOM edge on a surface height, so layouts
// stack exactly instead of by hand-tuned centre arithmetic.
// Weak-point design (fun research 2.1/2.3/3.4): stone mass rests on wood or
// glass supports in every level; pumpkins sit visible in gaps, positioned to
// die from falling mass / crush, not only from a direct dummy hit.
function blk(cx,bottomY,w,h,mat){var b=makeBlock(cx,bottomY-h/2,w,h,mat);tower.push(b);return b;}
function pkn(cx,bottomY){var p=makePumpkin(cx,bottomY-24);towerPumpkins.push(p);if(!towerPumpkin)towerPumpkin=p;return p;}
function buildLevel1(){
  // BIG house (amended Stage 6, 14 blocks), one pumpkin in the ground shelter.
  // F1 fix (self critique #1, 2026-10-28 23:22 CT): the first enlarged build
  // could not be beaten in 5 - the wood side cubes shielded the shelter and
  // the 24-wide glass posts were hard for the 0.86-mass dummy to reach.
  // Now: side cubes are GLASS 40s set wider out (a low shot breaks through
  // instead of stopping), the shelter posts are THIN glass (16 wide, 80 tall)
  // moved in to x 968/1112 so they stand exposed at flat-shot height, and the
  // beam they carry is a heavier wood beam (264x26, mass ~6.9) whose bottom
  // sits only ~32 px above the pumpkin top - break ONE post and the beam
  // tips straight onto the pumpkin (crush: mass >= 2 resting on top).
  // Storey bottoms above are re-stacked on the new beam top (baseY-106).
  blk(860,baseY,40,40,'glass'); blk(1220,baseY,40,40,'glass'); // side cubes
  blk(968,baseY,16,80,'glass'); blk(1112,baseY,16,80,'glass');
  blk(1040,baseY-80,264,26,'wood');
  blk(970,baseY-106,24,80,'wood'); blk(1110,baseY-106,24,80,'wood');
  blk(1040,baseY-186,220,20,'glass');
  blk(990,baseY-206,24,70,'glass'); blk(1090,baseY-206,24,70,'glass');
  blk(1040,baseY-276,200,24,'wood');
  blk(1010,baseY-300,20,50,'wood'); blk(1070,baseY-300,20,50,'wood');
  blk(1040,baseY-350,170,24,'stone');
  pkn(1040,baseY);
}
function buildLevel2(){
  // BIG wide fort (17 blocks), two pumpkins: ground shelter + on the first
  // beam. Weak points: glass ground posts AND glass third-storey posts, with
  // stone caps above both, so a hit at either height brings mass down.
  blk(850,baseY,50,50,'glass'); blk(1230,baseY,50,50,'glass'); // side cubes
  blk(920,baseY,24,90,'glass'); blk(1160,baseY,24,90,'glass');
  blk(1040,baseY-90,300,24,'wood');
  blk(940,baseY-114,24,80,'wood'); blk(1140,baseY-114,24,80,'wood');
  blk(1040,baseY-194,280,24,'stone');
  blk(970,baseY-218,24,70,'glass'); blk(1110,baseY-218,24,70,'glass');
  blk(1040,baseY-288,240,24,'wood');
  blk(990,baseY-312,24,60,'wood'); blk(1090,baseY-312,24,60,'wood');
  blk(1040,baseY-372,220,24,'stone');
  blk(1015,baseY-396,20,44,'glass'); blk(1065,baseY-396,20,44,'glass');
  blk(1040,baseY-440,150,20,'stone');
  pkn(1040,baseY);
  pkn(1040,baseY-114);
}
function buildLevel3(){
  // BIG tall keep (19 blocks), three pumpkins on three storeys. Weak point
  // stays the plan's seam: a wide GLASS base plank carrying the whole stack,
  // plus glass posts in storey three; stone sits at two heights so any
  // collapse drops heavy mass onto the pumpkins below.
  blk(1040,baseY,260,20,'glass');                       // glass base plank (the seam)
  blk(930,baseY-20,24,75,'wood'); blk(1150,baseY-20,24,75,'wood');
  blk(1040,baseY-95,260,24,'wood');
  blk(950,baseY-119,24,75,'wood'); blk(1130,baseY-119,24,75,'wood');
  blk(1040,baseY-194,240,24,'stone');
  blk(970,baseY-218,24,70,'glass'); blk(1110,baseY-218,24,70,'glass');
  blk(1040,baseY-288,220,24,'wood');
  blk(985,baseY-312,24,65,'wood'); blk(1095,baseY-312,24,65,'wood');
  blk(1040,baseY-377,200,24,'stone');
  blk(1005,baseY-401,20,50,'glass'); blk(1075,baseY-401,20,50,'glass');
  blk(1040,baseY-451,160,20,'stone');
  blk(880,baseY,46,46,'stone'); blk(1200,baseY,46,46,'wood'); // side cubes
  pkn(1040,baseY-20);
  pkn(1040,baseY-119);
  pkn(1040,baseY-218);
