  // creeping at ~0.19 speed indefinitely, so 0.15 never fired. Rest uses the
  // Stage 2 proven rest criterion: linear <0.35 px/step (~21 px/s) plus a
  // separate tight angular check <0.05 rad/step, sustained 60 steps.
  if(mx<0.35&&ma<0.05){restState.restSteps++;}else{restState.restSteps=0;}
