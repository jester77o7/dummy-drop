// --- Stage 7 DRAW PASS (Muse hand-coded, H1 of critique #3) ---
// Generated art as stickers (Alexander's idea, 2026-10-28 23:09 CT): the
// background picture fills the canvas; each block paints its material
// texture CROPPED through a source rectangle to the block's shape (never
// stretched whole), cracks drawn OVER the texture. If an image has not
// loaded, a flat shaded fill stands in. Drawing only - physics untouched.
var IMG={};
function loadImg(key,src){var i=new Image();i.src=src;IMG[key]=i;}
loadImg('bg','background.jpg');loadImg('wood','tex-wood.jpg');
loadImg('stone','tex-stone.jpg');loadImg('ice','tex-ice.jpg');
function imgReady(i){return i&&i.complete&&i.naturalWidth>0;}
var TEXFOR={wood:'wood',stone:'stone',glass:'ice'};
function drawBlock(b){
  var w=b.plugin.w||40,h=b.plugin.h||24,mat=b.plugin.material;
  ctx.save();ctx.translate(b.position.x,b.position.y);ctx.rotate(b.angle);
  ctx.beginPath();ctx.rect(-w/2,-h/2,w,h);ctx.clip();
  var img=IMG[TEXFOR[mat]];
  if(imgReady(img)){
    // Crop, never stretch whole: the source window covers ~300 game px of
    // texture, offset per body id so neighbouring blocks do not repeat.
    var sw=Math.min(512,w/300*512),sh=Math.min(512,h/300*512);
    var sx=(b.id*37)%Math.max(1,512-sw),sy=(b.id*53)%Math.max(1,512-sh);
    ctx.drawImage(img,sx,sy,sw,sh,-w/2,-h/2,w,h);
    if(mat==='glass')ctx.fillStyle='rgba(190,230,240,0.38)';
    else if(mat==='stone')ctx.fillStyle='rgba(70,70,80,0.10)';
    else ctx.fillStyle='rgba(120,70,20,0.08)';
    ctx.fillRect(-w/2,-h/2,w,h);
  }else{
    ctx.fillStyle=MATERIALS[mat].color;ctx.fillRect(-w/2,-h/2,w,h);
    if(mat==='wood'){ctx.strokeStyle='rgba(80,50,15,0.5)';ctx.lineWidth=1;for(var g=1;g<4;g++){ctx.beginPath();ctx.moveTo(-w/2,-h/2+h*g/4);ctx.lineTo(w/2,-h/2+h*g/4);ctx.stroke();}}
    if(mat==='glass'){ctx.strokeStyle='rgba(255,255,255,0.7)';ctx.beginPath();ctx.moveTo(-w/2+4,h/2-3);ctx.lineTo(w/2-8,-h/2+3);ctx.stroke();}
    if(mat==='stone'){ctx.fillStyle='rgba(40,40,40,0.35)';for(var s=0;s<5;s++){ctx.fillRect(((b.id*31+s*47)%Math.max(2,w))-w/2,((b.id*17+s*29)%Math.max(2,h))-h/2,2,2);}}
  }
  // Shading: top highlight, darker bottom edge (kills the flat 2003 look).
  var grad=ctx.createLinearGradient(0,-h/2,0,h/2);
  grad.addColorStop(0,'rgba(255,255,255,0.22)');grad.addColorStop(0.5,'rgba(255,255,255,0)');
  grad.addColorStop(1,'rgba(0,0,0,0.20)');ctx.fillStyle=grad;ctx.fillRect(-w/2,-h/2,w,h);
  ctx.restore();
  ctx.save();ctx.translate(b.position.x,b.position.y);ctx.rotate(b.angle);
  ctx.strokeStyle='rgba(25,20,15,0.85)';ctx.lineWidth=1.5;ctx.strokeRect(-w/2,-h/2,w,h);
  // Crack marks OVER the texture at half health or below.
  if(b.plugin.health<=b.plugin.maxHealth/2){
    ctx.strokeStyle='rgba(15,15,15,0.85)';ctx.lineWidth=1.5;ctx.beginPath();
    ctx.moveTo(-w/2,-h/2);ctx.lineTo(-w*0.15,0);ctx.lineTo(-w*0.3,h/2);
    ctx.moveTo(w/2,-h*0.2);ctx.lineTo(w*0.1,h*0.1);ctx.lineTo(w*0.25,h/2);
    ctx.stroke();
  }
  ctx.restore();ctx.lineWidth=1;
}
function drawDummyPart(b){
  var w=b.plugin.w||10,h=b.plugin.h||10,name=b.plugin.part;
  ctx.save();ctx.translate(b.position.x,b.position.y);ctx.rotate(b.angle);
  ctx.fillStyle='#f2c018';ctx.strokeStyle='#1c1c1c';ctx.lineWidth=1.2;
  ctx.beginPath();ctx.rect(-w/2,-h/2,w,h);ctx.fill();ctx.stroke();
  // Top highlight for a little depth.
  ctx.fillStyle='rgba(255,255,255,0.25)';ctx.fillRect(-w/2,-h/2,w,Math.max(1,h*0.25));
