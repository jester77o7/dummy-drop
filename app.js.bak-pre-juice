M.Events.on(engine,'afterUpdate',function(){
  var bodies=M.Composite.allBodies(world);
  var mx=0,ma=0;
  for(var i=0;i<bodies.length;i++){
    var b=bodies[i];
    if(b.isStatic)continue;
    if(b.isSleeping)continue;
    mx=Math.max(mx,Math.hypot(b.velocity.x,b.velocity.y));
    // Angular wrap fix (2026-10-28 23:0x CT, probe-rest025): Matter derives
    // angularVelocity from the angle delta, so a part lying at angle ~ +/-PI
    // that micro-jitters across the wrap reports a spurious +/-2*PI per step
    // forever (head +6.282, upperLegL -6.282 at linear speed ~0.05), which
    // defeated the angular rest check at the 0.25 dummy scale. Wrap the delta
    // into [-PI, PI] before judging rest; real spins here are far below PI/step.
    ma=Math.max(ma,Math.abs(Math.atan2(Math.sin(b.angularVelocity),Math.cos(b.angularVelocity))));
  }
  restState.maxBodySpeed=mx;
